{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nexus-s1-468cba",
	"main": "apps/worker/src/index.ts",
	"compatibility_date": "2026-08-22",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"binding": "ASSETS",
		"directory": "./apps/console/dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api",
			"/api/*"
		]
	},
	"vars": {
		"CONSOLE_ORIGIN": "http://127.0.0.1:5173",
		"STOREFRONT_ORIGIN": "http://127.0.0.1:5174"
	},
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "nexus-s1-468cba-private"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nexus-s1-468cba-db",
			"database_id": "7424d853-fa0b-4e6c-b341-eca85b82e4bd"
		}
	],
	"env": {
		"production": {
			"name": "nexus-handson-console",
			"vars": {
				"CONSOLE_ORIGIN": "https://nexus-handson-console.cppai.workers.dev",
				"STOREFRONT_ORIGIN": "https://nexus-handson-akbuild.cppai.workers.dev"
			},
			"r2_buckets": [
				{
					"binding": "FILES",
					"bucket_name": "nexus-handson-akbuild-private"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "nexus-handson-akbuild-db",
					"database_id": "b5a48743-ed25-41e4-9ed8-4f48b619b9b5"
				}
			]
		},
		"s4-provisioning": {
			"vars": {
				"CONSOLE_ORIGIN": "https://s4-provisioning.invalid",
				"STOREFRONT_ORIGIN": "https://s4-provisioning.invalid"
			},
			"r2_buckets": [
				{
					"binding": "FILES",
					"bucket_name": "nexus-s1-468cba-private",
					"remote": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "nexus-s1-468cba-db",
					"database_id": "7424d853-fa0b-4e6c-b341-eca85b82e4bd",
					"remote": true
				}
			]
		}
	}
}
